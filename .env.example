# Copy to .env and fill in your Firecrawl API key (firecrawl.dev -> API keys).
# This file is for local use only; .env is gitignored.
FIRECRAWL_API_KEY=fc-REPLACE_ME

# Optional: 1Password reference instead of a raw key (requires the `op` CLI).
# ONEPASSWORD_FIRECRAWL_REFERENCE=op://Vault/Item/field

# Optional: persistent directory for auto-named payload files.
# FIRECRAWL_CLI_OUTPUT_DIR=/absolute/path/to/web_snapshots/firecrawl_raw
